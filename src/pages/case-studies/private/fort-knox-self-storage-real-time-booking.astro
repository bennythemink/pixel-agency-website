---
import ContactForm from '@components/ContactForm.astro'
import { SitePage } from '@data/analyticsCaller'
import Grid from '@components/Grid.astro'
import Layout from '@layouts/Layout.astro'
import CaseStudySectionText from '@components/case-studies/case-study/CaseStudySectionText.astro'
import CaseStudyResults from '@components/case-studies/case-study/CaseStudyResults.astro'
import CaseStudyHeader from '@components/case-studies/case-study/CaseStudyHeader.astro'
import CaseStudyToggleButton from '@components/case-studies/case-study/CaseStudyToggleButton.astro'
import CaseStudyMetaData from '@components/case-studies/case-study/CaseStudyMetaData.astro'
import CaseStudyShout from '@components/case-studies/case-study/CaseStudyShout.astro'
import CaseStudyNav from '@components/case-studies/case-study/CaseStudyNav.astro'
import CaseStudyImages from '@components/case-studies/case-study/CaseStudyImages.astro'

import hero from '@assets/case-studies/fort-knox/hero.webp'
import squareOne from '@assets/case-studies/fort-knox/squareOne.svg'
import squareTwo from '@assets/case-studies/fort-knox/squareTwo.webp'
import wideOne from '@assets/case-studies/fort-knox/wideOne.webp'
import wideTwo from '@assets/case-studies/fort-knox/wideTwo.webp'
import { getCaseStudyNav } from '@data/caseStudies'

const { previous, next } = getCaseStudyNav('fort-knox-self-storage-real-time-booking')
---

<Layout
  title="Fort Knox Case Study"
  description="Website design and development, plus a custom inventory and bookings platform, for Fort Knox Self Storage, managed as a multi-year partner."
  published={false}
>
  <article id="case-study-page">
    <CaseStudyHeader>
      <span slot="title">Fort Knox</span>
      <span slot="industry">Self Storage</span>
      <span slot="services">Discovery + direction, Design, Development, Consulting</span>
      <span slot="duration">4 months</span>
    </CaseStudyHeader>

    <CaseStudyToggleButton />

    <!-- Single shell: all images + summary (left pane) / all case study text (right pane) -->
    <section class="pb-12 lg:pb-18">
      <Grid>
        <div id="case-study-shell" class="case-study-shell col-span-full">
          <div class="case-study-left-pane min-w-0 overflow-hidden">
            <CaseStudyImages
              heroImage={{ src: hero }}
              summary="How Pixel Agency built Fort Knox Self Storage a website and the custom internal platform behind it, running availability, pricing, and bookings across 11 Melbourne locations as one."
              squareImages={[{ src: squareOne }, { src: squareTwo }]}
              wideImages={[{ src: wideOne }, { src: wideTwo }]}
            />
          </div>

          <div class="case-study-right-pane min-w-0">
            <CaseStudyShout
              >A website and the custom inventory platform behind it, built to run 11 Melbourne storage locations as
              one.</CaseStudyShout
            >

            <CaseStudySectionText title="The client" noTopMargin={true}>
              <p class="">
                Fort Knox Self Storage is one of Melbourne's most recognised independent self storage operators, with 11
                facilities across the greater metro area, from West Melbourne to Dandenong, Coburg to Ringwood. Their
                audience runs the full range that self storage serves: residential customers needing space for
                furniture, wine, cars, or boats between moves, and business customers using their facilities for office,
                commercial, warehouse, and archival storage. With locations spread across Melbourne and a customer base
                that needs answers fast (what size, what location, what price, available now), the digital experience
                had to do a lot of work.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The problem">
              <p>
                Running 11 self storage locations as one business is harder than it looks. The Fort Knox team needed a
                public website that gave customers an immediate read on what was available, where, and at what price,
                without the customer having to ring three locations to find out.
              </p><br />
              <p>
                They also needed the system behind the scenes to actually reflect reality: which units were free at
                which site, what the current pricing was per location and size, who was in which unit, and how a
                customer booking online turned into a real reservation against real inventory. A standard off-the-shelf
                website couldn't carry that. A standard off-the-shelf storage platform couldn't carry the brand and
                customer experience. They needed both, built to work as one.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The approach">
              <p>
                We started with discovery, working with the Fort Knox team to map two things at once: how a customer was
                actually trying to find storage (and where the existing experience was getting in the way), and how the
                business itself was managing inventory, tenants, pricing, and bookings across 11 sites. Discovery
                surfaced that the website and the internal system couldn't be designed separately. The customer
                experience on the public site, the instant quote, the location-by-location availability, the reservation
                flow, was only as good as the inventory data feeding it, and the inventory data was only useful if the
                staff actually wanted to use the tool that managed it. We scoped the engagement as two builds that had
                to behave as one.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The solution">
              <p>
                We designed and built a customer-facing Fort Knox Self Storage website that put the most important
                questions front and centre: where, what size, how much, available now. Behind it, we built a custom
                internal web application that became the operating system of the business. The app gave the Fort Knox
                team real-time unit availability across every location, control over pricing by location and unit size,
                an online booking flow that wrote directly into the inventory, and a tenant and unit management tool the
                in-branch staff actually used day-to-day. The website and the internal app were designed as one system,
                so a customer reserving a 3 metre unit at Coburg saw real availability, the booking landed against real
                inventory, and the staff at Coburg saw it without anyone having to phone anyone. As the business grew,
                we kept building: new features, new locations onto the platform, ongoing content and site updates, and
                the technical support to keep both pieces running.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The results">
              <p>The qualitative story across the multi-year partnership tells itself:</p>
              <CaseStudyResults
                results={[
                  {
                    title: 'A customer-facing website',
                    description: 'built around how people actually shop for self storage',
                    backgroundColour: 'pixel-solar'
                  },
                  {
                    title: 'A custom internal platform',
                    description: 'running availability, pricing, bookings, and tenants from one place',
                    backgroundColour: 'pixel-celestial'
                  },
                  {
                    title: 'Real-time inventory',
                    description: 'across 11 Melbourne locations, feeding the site and the front desk',
                    backgroundColour: 'pixel-rosy'
                  },
                  {
                    title: 'Online bookings',
                    description: 'flowing straight into the inventory the staff use day-to-day',
                    backgroundColour: 'pixel-teal'
                  },
                  {
                    title: 'New locations added',
                    description: 'onto the platform as Fort Knox expanded across the city',
                    backgroundColour: 'pixel-fawn'
                  }
                ]}
              />

              <div class="mt-6 lg:mt-12"></div>

              <CaseStudyShout
                >Success behind the scenes built the trust for Fort Knox to hand us the customer-facing platform.</CaseStudyShout
              >
            </CaseStudySectionText>

            <CaseStudyMetaData
              client={{ name: 'Fort Knox Self Storage', url: 'https://fortknoxselfstorage.com.au' }}
              industry={['Self Storage']}
              serviceNames={['Discovery + direction', 'Design', 'Development', 'Consulting']}
            />
          </div>
        </div>
      </Grid>
    </section>

    {/* Navigation section */}
    <CaseStudyNav previousCaseStudy={previous} nextCaseStudy={next} />

    <ContactForm
      title="Discuss a similar challenge"
      displayDescription={false}
      caller={SitePage.CASE_STUDIES_PRIVATE_FORT_KNOX}
    />
  </article>

  <style>
    #case-study-page {
      --case-study-border: color-mix(in oklab, var(--color-black) 8%, transparent);
      --case-study-placeholder: var(--color-pixel-placeholder-grey);
    }

    @media (max-width: 1023px) {
      .case-study-shell {
        display: flex;
        gap: 0;
        overflow: clip;
      }

      .case-study-left-pane {
        flex: 0 0 auto;
        width: 100%;
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 240ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      #case-study-page[data-panel-state='open'] .case-study-left-pane {
        width: 0;
        max-height: 0;
        opacity: 0;
        transform: translateX(-2rem);
        pointer-events: none;
      }

      .case-study-right-pane {
        flex: 0 0 auto;
        width: 0;
        max-height: 0;
        opacity: 0;
        overflow: clip;
        transform: translateX(2rem);
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 260ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      #case-study-page[data-panel-state='open'] .case-study-right-pane {
        width: 100%;
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
    }

    @media (min-width: 1024px) {
      .case-study-shell {
        display: flex;
        gap: 0;
        transition: gap 420ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #case-study-page[data-panel-state='open'] .case-study-shell {
        gap: 1.25rem;
      }

      .case-study-left-pane,
      .case-study-right-pane {
        flex: 0 0 auto;
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 260ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      .case-study-left-pane {
        width: 100%;
        max-height: 5000px;
      }

      .case-study-right-pane {
        width: 0;
        max-height: 0;
        opacity: 0;
        transform: translateX(2rem);
        overflow: clip;
        pointer-events: none;
      }

      #case-study-page[data-panel-state='open'] .case-study-left-pane {
        width: calc(50% - 0.625rem);
      }

      #case-study-page[data-panel-state='open'] .case-study-right-pane {
        width: calc(50% - 0.625rem);
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .case-study-shell,
      .case-study-left-pane,
      .case-study-right-pane {
        transition: none;
      }
    }
  </style>

  <script>
    function initCaseStudyPage() {
      const page = document.getElementById('case-study-page')
      const toggle = document.getElementById('case-study-toggle')
      if (!(page instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return
      const pageElement = page
      const toggleButton = toggle

      const mobileMedia = window.matchMedia('(max-width: 1023px)')

      function setToggleTextColor() {
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-bgc').trim()
        const match = accent.match(/(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/)
        if (!match) return

        let red = parseInt(match[1], 10) / 255
        let green = parseInt(match[2], 10) / 255
        let blue = parseInt(match[3], 10) / 255

        red = red <= 0.03928 ? red / 12.92 : Math.pow((red + 0.055) / 1.055, 2.4)
        green = green <= 0.03928 ? green / 12.92 : Math.pow((green + 0.055) / 1.055, 2.4)
        blue = blue <= 0.03928 ? blue / 12.92 : Math.pow((blue + 0.055) / 1.055, 2.4)

        const luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue
        document.documentElement.style.setProperty('--case-study-toggle-text', luminance > 0.4 ? '#000' : '#fff')
      }

      function getDefaultState() {
        return 'closed'
      }

      if (!pageElement.dataset.panelState) {
        pageElement.dataset.panelState = getDefaultState()
      }

      function syncA11y() {
        const isOpen = pageElement.dataset.panelState === 'open'
        toggleButton.setAttribute('aria-expanded', String(isOpen))
      }

      setToggleTextColor()
      syncA11y()

      toggleButton.addEventListener('click', () => {
        pageElement.dataset.panelState = pageElement.dataset.panelState === 'open' ? 'closed' : 'open'
        syncA11y()
      })
    }

    initCaseStudyPage()
    document.addEventListener('astro:after-swap', initCaseStudyPage)
  </script>
</Layout>
