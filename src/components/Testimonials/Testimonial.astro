---
import { Image } from 'astro:assets'
import quote from '@assets/quote.svg'
import { resolvePixelColour } from '@config/colours'

interface Props {
  text: string
  author: string
  role: string
  organisation: string
  organisationUrl: string
  colour: string
}

const { text, author, role, organisation, organisationUrl, colour } = Astro.props
---

<article
  class="shrink-0 w-[65vw] sm:w-[70vw] lg:w-[320px] min-h-[105px] lg:min-h-[115px] p-6 lg:p-8 flex flex-col justify-between"
  style={`background-color: ${resolvePixelColour(colour)};`}
>
  <div class="flex flex-row items-start gap-4 lg:gap-5">
    <Image src={quote} alt="" class="w-6 lg:w-7 h-auto shrink-0" />
    <p class="flex-1 min-w-0 font-sans italic text-base lg:text-lg leading-[1.35] tracking-[-0.01em] lg:mt-2">
      &ldquo;{text}&rdquo;
    </p>
  </div>
  <div class="font-sans text-base leading-[1.3] lg:pl-12 mt-8 lg:mt-10">
    <p>{author}</p>
    <p>{role}</p>
    <a href={organisationUrl} class="underline underline-offset-2" target="_blank">{organisation}</a>
  </div>
</article>
