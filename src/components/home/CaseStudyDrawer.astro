---
import { featuredCaseStudies, resolveColour } from '@data/caseStudies'

interface CaseStudyItem {
  title: string
  slug: string
  image: ImageMetadata | string
  colour: string
  drawerPosition?: string
  imageAltText?: string
}

interface Props {
  items?: CaseStudyItem[]
  size?: 'default' | 'small'
}

export function mapCaseStudiesToItems(caseStudies: typeof featuredCaseStudies): CaseStudyItem[] {
  return caseStudies.map((cs) => ({
    title: cs.title,
    slug: `/case-studies/${cs.slug}`,
    image: cs.drawerImage ?? cs.image,
    colour: cs.colour,
    drawerPosition: cs.drawerPosition,
    imageAltText: cs.imageAltText
  }))
}

const defaultItems: CaseStudyItem[] = mapCaseStudiesToItems(featuredCaseStudies)

const { items = defaultItems, size = 'default' } = Astro.props

function getImageSrc(image: ImageMetadata | string): string {
  return typeof image === 'string' ? image : image.src
}

const BANNER_HEIGHT_MOBILE = size === 'small' ? 34 : 40
const BANNER_HEIGHT_DESKTOP = size === 'small' ? 34 : 48
const IMAGE_HEIGHT_SMALL = 280
const containerStyle = size === 'small' ? `height: ${IMAGE_HEIGHT_SMALL + items.length * 34}px;` : undefined
const containerClass =
  size === 'small' ? 'relative w-full overflow-hidden' : 'relative w-full overflow-hidden h-[500px] lg:h-[700px]'
---

<div
  id="case-study-drawer"
  class={containerClass}
  style={containerStyle}
  data-count={items.length}
  data-banner-height-mobile={BANNER_HEIGHT_MOBILE}
  data-banner-height-desktop={BANNER_HEIGHT_DESKTOP}
>
  {
    items.map((item, i) => {
      const cr = resolveColour(item.colour)
      return (
        <div
          class={`drawer absolute inset-x-0 h-full flex flex-col${cr.class ? ` ${cr.class}` : ''}`}
          data-index={i}
          style={`${cr.style ? `${cr.style}; ` : ''}z-index: ${i + 1}; top: ${i * BANNER_HEIGHT_MOBILE}px;`}
        >
          <button
            class={`drawer-banner w-full text-left px-5 font-sans font-normal text-sm lg:text-base flex items-center shrink-0 hover:brightness-95 transition-[filter] cursor-pointer${cr.class ? ` ${cr.class}` : ''}`}
            style={`${cr.style ? `${cr.style}; ` : ''}height: ${BANNER_HEIGHT_MOBILE}px;`}
            data-index={i}
            type="button"
          >
            <span class="underline underline-offset-2">{item.title}</span>
          </button>
          <a href={item.slug} target="_blank" rel="noopener noreferrer" class="drawer-image block overflow-hidden">
            <img
              src={getImageSrc(item.image)}
              alt={item.imageAltText || item.title}
              class={`w-full h-full object-cover transition-[filter] duration-300 ${item.drawerPosition ? `${item.drawerPosition}` : 'object-center'}`}
            />
            {/* class={`w-full h-full object-cover grayscale transition-[filter] duration-300 hover:grayscale-0 object-top`} */}
            {/* class={`w-full h-full object-cover grayscale transition-[filter] duration-300 hover:grayscale-0 ${item.imagePosition ? `${item.imagePosition}` : 'object-center'}`} */}
          </a>
        </div>
      )
    })
  }
</div>

<script>
  import { gsap } from 'gsap'

  function initDrawer() {
    const container = document.getElementById('case-study-drawer')
    if (!container) return

    const drawers = container.querySelectorAll<HTMLElement>('.drawer')
    const banners = container.querySelectorAll<HTMLButtonElement>('.drawer-banner')
    const BANNER_H_MOBILE = parseInt(container.dataset.bannerHeightMobile || '40')
    const BANNER_H_DESKTOP = parseInt(container.dataset.bannerHeightDesktop || '48')
    const LG_BREAKPOINT = 1024

    function getBannerH() {
      return window.innerWidth >= LG_BREAKPOINT ? BANNER_H_DESKTOP : BANNER_H_MOBILE
    }
    const count = drawers.length

    let activeIndex = count - 1

    function updatePositions(animate = true) {
      const containerH = container!.offsetHeight
      const BANNER_H = getBannerH()

      // Update banner and image heights
      const imageH = containerH - count * BANNER_H
      banners.forEach((banner) => {
        banner.style.height = `${BANNER_H}px`
      })
      container!.querySelectorAll<HTMLElement>('.drawer-image').forEach((link) => {
        link.style.height = `${imageH}px`
      })

      drawers.forEach((drawer, i) => {
        let targetTop: number
        if (i <= activeIndex) {
          targetTop = i * BANNER_H
        } else {
          const closedCount = count - activeIndex - 1
          const posInClosed = i - activeIndex - 1
          targetTop = containerH - (closedCount - posInClosed) * BANNER_H
        }

        if (animate) {
          gsap.to(drawer, { top: targetTop, duration: 0.5, ease: 'power2.inOut' })
        } else {
          gsap.set(drawer, { top: targetTop })
        }
      })
    }

    banners.forEach((banner) => {
      banner.addEventListener('click', () => {
        const index = parseInt(banner.dataset.index || '0')
        if (index === activeIndex) return
        activeIndex = index
        updatePositions()
      })
    })

    // Set initial positions without animation
    updatePositions(false)
  }

  initDrawer()
  document.addEventListener('astro:page-load', initDrawer)
</script>
